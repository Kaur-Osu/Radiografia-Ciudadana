# Configuración de Conexión a Base de Datos MySQL 8.0
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contrasena_aqui
DB_NAME=radiografia_ciudadana

# Ruta relativa o absoluta a los datos oficiales brutos del INE
DATA_PATH=../data

# Configuración del servidor API FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Seguridad y Autenticación JWT (Generar clave segura en producción)
SECRET_KEY=tu_clave_secreta_jwt_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Entorno de ejecución (development / production)
ENVIRONMENT=development
DEBUG=false
